# ── Supabase (client, build-time) ─────────────────────────────────────────────
VITE_SUPABASE_URL=https://jaqzjhabmtvqtvinoafq.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_vMsNKA4Icb2BD9SzgBTz4A_DTmSnwWb
VITE_USE_SUPABASE=true

# ── Auth / access gating ───────────────────────────────────────────────────────
VITE_REQUIRE_AUTH=false
# New non-admin users require admin approval before entering the app (closed beta).
# Set to "false" for open self-serve signup (new users are activated immediately).
VITE_REQUIRE_ADMIN_APPROVAL=true

VITE_ALLOW_PROVIDER_SIMULATION=true

# ── Social OAuth: CLIENT ids (build-time, safe to expose) ──────────────────────
VITE_GOOGLE_CLIENT_ID=857437726846-ckcn1mqo4p1p8vstsq5tehnn3pvhnbsr.apps.googleusercontent.com
# X / Twitter public client id (needed for the "Connect X" button to build an auth URL)
VITE_X_CLIENT_ID=

# ── Social OAuth: SERVER secrets (set in Vercel env / Secrets — NEVER VITE_-prefixed, never commit real values) ──
# Required for /api/auth/*/callback token exchange + refresh to work in production.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=

# ── Supabase (server) — required so serverless callbacks persist accounts/media under RLS ──
SUPABASE_URL=https://jaqzjhabmtvqtvinoafq.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ── AI provider keys (server, set in Vercel / Secrets) ─────────────────────────
# Only the providers you actually use need keys; without them the app runs in provider-simulation mode.
GOOGLE_AI_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
KLING_ACCESS_KEY=
KLING_SECRET_KEY=
ARK_API_KEY=

# YouTube Data API key — required for REAL research ingestion (channel/video analysis).
VITE_YOUTUBE_API_KEY=
